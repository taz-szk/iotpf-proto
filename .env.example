# PostgreSQL
POSTGRES_DB=iotplatform
POSTGRES_USER=iotadmin
POSTGRES_PASSWORD=changeme_strong_password

# InfluxDB
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=changeme_strong_password
INFLUXDB_ADMIN_TOKEN=changeme_admin_token_min_64_characters_required_use_openssl_rand_hex_32
INFLUXDB_ORG=iotplatform
INFLUXDB_BUCKET=system

# EMQX
EMQX_DASHBOARD_PASSWORD=changeme_strong_password
EMQX_NODE_COOKIE=changeme_cluster_cookie_min_20_chars

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_strong_password

# Step-CA
STEP_CA_PASSWORD=changeme_ca_password

# Nginx / TLS
PLATFORM_DOMAIN=platform.local

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password

# Core API
JWT_SECRET=changeme_jwt_secret_min_32_characters_replace_in_prod

# Platform Admin (initial login at /admin/)
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=changeme_platform_admin_password

# OTA / MinIO（Core APIがMinIOにアクセスするための設定）
# MINIO_ENDPOINT/MINIO_ACCESS_KEY/MINIO_SECRET_KEY は MinIO の設定を流用
# EMQX_API_USER=admin  ← デフォルト（変更不要）
# EMQX_API_PASSWORD は EMQX_DASHBOARD_PASSWORD と同じ値を使用

# Alert Service - SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=changeme_smtp_password
SMTP_FROM=alerts@iot-platform.local

# Alert/Ingestion Service
EVAL_INTERVAL_SEC=60
DEVICE_OFFLINE_THRESHOLD_SEC=180
